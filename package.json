{
  "name": "derp-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "start": "bun server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "test:fast": "playwright test --project=chromium",
    "test:tablet": "playwright test --project=android-tablet",
    "test:all": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.7",
    "@fastify/middie": "^9.3.0",
    "ai": "^7.0.14",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.23.0",
    "pdfjs-dist": "^6.1.200",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.12"
  }
}
