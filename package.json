{
  "name": "derp-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --quiet --tsconfig tsconfig.json .",
    "check": "bun run typecheck && bun run lint",
    "build": "bun run typecheck && vite build",
    "test:unit": "bun test server/*.test.ts",
    "test": "AI_TEST_MOCK=1 playwright test",
    "test:fast": "AI_TEST_MOCK=1 playwright test --project=chromium",
    "test:tablet": "AI_TEST_MOCK=1 playwright test --project=android-tablet",
    "test:all": "AI_TEST_MOCK=1 playwright test",
    "test:real": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.7",
    "@fastify/middie": "^9.3.0",
    "@tanstack/solid-query": "^5.101.2",
    "@types/markdown-it": "^14.1.2",
    "ai": "^7.0.14",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.23.0",
    "markdown-it": "^14.3.0",
    "pdfjs-dist": "^6.1.200",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260706.1",
    "eslint-plugin-solid": "^0.14.5",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.12"
  }
}
